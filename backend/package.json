{
  "name": "hearth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The operating record of a house, exposed to Alexa+ as a self-hosted MCP server.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
